@page "/Admin/Users"
@model ThixInstall.Cloud.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Benutzer";
    ViewData["PageSub"] = "Die Konten dieser Cloud. Benutzer verwalten ihre eigenen Geräte, Administratoren alles.";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", null), ("Benutzer", null) };
}

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Items.Count == 0)
    {
        <partial name="_Empty" model="@(new EmptyStateModel("users", "Nichts gefunden", "Kein Benutzer passt zur Suche oder zu den Filtern.", false, null, null, Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <ti-table caption="Benutzer">
            <thead>
                <tr><th scope="col">Benutzer</th><th scope="col">Rolle</th><th scope="col">Status</th><th scope="col" class="mat-hide-md">Letzte Anmeldung</th><th scope="col" class="mat-num mat-hide-sm">Geräte</th><th scope="col" class="mat-num mat-hide-sm">Pakete</th><th scope="col"><span class="mat-sr-only">Aktionen</span></th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td data-label="Benutzer" class="mat-table__primary"><div class="mat-table__name"><span class="mat-avatar mat-avatar--sm" aria-hidden="true">@Ui.Initials(u.DisplayName)</span><span><a href="/Admin/Users/Edit?id=@u.Id">@u.DisplayName</a><small class="mat-mono">@u.UserName</small></span></div></td>
                        <td data-label="Rolle"><span class="mat-pill @(u.IsAdmin ? "mat-pill--accent" : "mat-pill--plain")">@(u.IsAdmin ? "Administrator" : "Benutzer")</span></td>
                        <td data-label="Status">@if (!u.IsActive) { <span class="mat-pill mat-pill--error">Deaktiviert</span> } else if (u.IsLocked) { <span class="mat-pill mat-pill--warn">Gesperrt</span> } else { <span class="mat-pill mat-pill--ok">Aktiv</span> }</td>
                        <td data-label="Letzte Anmeldung" class="mat-hide-md">@(u.LastLoginDate is null ? "Nie" : Dates.Stamp(u.LastLoginDate))</td>
                        <td data-label="Geräte" class="mat-num mat-mono mat-hide-sm">@u.Devices</td>
                        <td data-label="Pakete" class="mat-num mat-mono mat-hide-sm">@u.Bundles</td>
                        <td class="mat-table__cell-actions"><div class="mat-table__actions"><a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Admin/Users/Edit?id=@u.Id" aria-label="@u.DisplayName bearbeiten" data-tip="Bearbeiten">@Ui.Icon("edit")</a></div></td>
                    </tr>
                }
            </tbody>
        </ti-table>
    }

    <partial name="_Pager" model="Model.Pager" />

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Admin/Users/Edit">@Ui.Icon("plus")<span>Neuer Benutzer</span></a>
    </div>
</div>
