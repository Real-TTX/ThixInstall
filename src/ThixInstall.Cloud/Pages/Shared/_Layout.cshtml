@inject Assets Toolkit
@inject CurrentUser Me
@{
    // A page fills these in: Title, PageSub (one line under it), Crumbs (a list of (Text, Url?)), Width ("narrow" or "wide"), OwnHead (the page draws its own head),
    // PageClass (a class of the page). The menu follows the address.
    var user = Me.Snapshot!;
    var title = ViewData["Title"] as string ?? Ui.AppName;
    var sub = ViewData["PageSub"] as string;
    var crumbs = ViewData["Crumbs"] as IReadOnlyList<(string Text, string? Url)> ?? [];
    var width = ViewData["Width"] as string;
    var ownHead = ViewData["OwnHead"] is true;
    var themeAttr = user.Theme is "light" or "dark" ? $" data-theme=\"{user.Theme}\"" : string.Empty;
    var path = Context.Request.Path.Value;
    var area = Menu.AreaOf(path);
    var areas = Menu.Areas(Me.IsAdmin);
    var current = areas.First(a => a.Id == area);
}
<!DOCTYPE html>
<html lang="de" data-app="@Ui.AppId" data-dlg-ok="OK" data-dlg-cancel="Abbrechen" data-dlg-close="Schließen" data-dlg-confirm="Bitte bestätigen" data-dlg-notice="Hinweis" data-dlg-input="Eingabe" data-copied="Kopiert" data-msg-required="Bitte ausfüllen." data-msg-type="Bitte einen gültigen Wert eingeben." @Html.Raw(themeAttr)>
<head>
    <partial name="_Head" model="title" />
</head>
<body>
    <a class="mat-skip" href="#main">Zum Inhalt springen</a>
    @Html.Raw(Toolkit.Sprite)

    <div class="mat-app">
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a class="ti-brand" href="/Devices" aria-label="ThixInstall – zu den Geräten">
                    @Ui.Logo()
                    <span class="ti-brand__name">Thix<span>Install</span></span>
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label="Menü schließen">@Ui.Icon("x")</button>
            </div>

            <partial name="_Menu" model="area" />

            <div class="mat-nav__foot">
                <div class="mat-nav__switch mat-nav__switch--foot">
                    <button type="button" class="mat-switcher" data-menu-toggle="nav-switch-menu" data-menu-place="top" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-switcher__icon">@Ui.Icon(current.Icon)</span>
                        <span class="mat-switcher__text"><small data-nav-label="Menü">Menü</small><span class="mat-switcher__name">@current.Title</span></span>
                        @Ui.Icon("chevron-up", "mat-switcher__chev")
                        <span class="mat-switcher__dot" hidden></span>
                    </button>
                </div>
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-menu-toggle="user-menu" data-menu-place="top" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@Ui.Initials(user.DisplayName)</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@user.DisplayName</span>
                            <span class="mat-user__role">@Me.RoleName</span>
                        </span>
                        @Ui.Icon("chevron-up", "mat-user__chev")
                    </button>
                    <button type="button" class="mat-theme" data-theme-toggle data-theme-state="@user.Theme" data-theme-save-url="/Account?handler=Theme" aria-label="Design" title="Design">
                        <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                        <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                        <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                    </button>
                </div>
                @* the version leads to the About page *@
                <div class="mat-nav__version"><a href="/About" title="Über ThixInstall">@AppInfo.Version</a></div>
            </div>
        </aside>

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label="Menü öffnen" aria-controls="mat-nav" aria-expanded="false">@Ui.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label="Brotkrumen">
                    <ol>
                        @if (crumbs.Count == 0)
                        {
                            <li aria-current="page">@title</li>
                        }
                        else
                        {
                            @for (var i = 0; i < crumbs.Count; i++)
                            {
                                var c = crumbs[i];
                                if (i == crumbs.Count - 1 || c.Url is null)
                                {
                                    <li aria-current="page">@c.Text</li>
                                }
                                else
                                {
                                    <li><a href="@c.Url">@c.Text</a></li>
                                }
                            }
                        }
                    </ol>
                </nav>
                <div class="mat-topbar__actions">
                    @* shown only while the device is offline (offline.js); a click tries again *@
                    <button type="button" class="ti-offline" id="ti-offline" hidden>@Ui.Icon("cloud")<span data-offline-text>Offline</span></button>
                    @await RenderSectionAsync("TopActions", required: false)
                    <a class="mat-btn mat-btn--primary mat-btn--icon" href="/" aria-label="Paket zusammenstellen" data-tip="Paket zusammenstellen">@Ui.Icon("plus")</a>
                </div>
            </header>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "") @(ViewData["PageClass"])" id="main">
                @if (!ownHead)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@title</h1>
                            @if (!string.IsNullOrEmpty(sub))
                            {
                                <p class="mat-page__sub">@sub</p>
                            }
                        </div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    @* the switcher of the menus (SHELL-15): the management, the account and – for an administrator – the administration *@
    <div class="mat-menu" id="nav-switch-menu" role="menu" aria-label="Menüs" data-nav-scope="mat-nav" hidden>
        @foreach (var a in areas)
        {
            <a class="mat-menu__item" href="@a.Href" role="menuitemradio" aria-checked="@(a.Id == area ? "true" : "false")" data-nav-set="@a.Id" data-nav-title="@a.Title">
                @Ui.Icon(a.Icon)<span>@a.Title</span>
                @Ui.Icon("check", "mat-menu__check")
            </a>
        }
    </div>

    <div class="mat-menu" id="user-menu" role="menu" aria-label="@user.DisplayName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@Ui.Initials(user.DisplayName)</span>
            <div><strong>@user.DisplayName</strong><small>@user.UserName</small></div>
        </div>
        <a class="mat-menu__item" role="menuitem" href="/Account">@Ui.Icon("settings")<span>Konto</span></a>
        <a class="mat-menu__item" role="menuitem" href="/Devices">@Ui.Icon("monitor")<span>Geräte</span></a>
        <button type="button" class="mat-menu__item" role="menuitem" data-pwa-install hidden>@Ui.Icon("download")<span>App installieren</span></button>
        <div class="mat-menu__sep" role="separator"></div>
        <form method="post" action="/Account/Logout" data-logout>
            @Html.AntiForgeryToken()
            <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem">@Ui.Icon("logout")<span>Abmelden</span></button>
        </form>
    </div>

    @* the anti-forgery token of the page: the scripts send it with their requests *@
    <form hidden data-page-token>@Html.AntiForgeryToken()</form>

    @if (TempData["Flash"] is string flash)
    {
        <div data-toast="@flash" data-tone="success" hidden></div>
    }

    @if (TempData["FlashError"] is string flashError)
    {
        <div data-toast="@flashError" data-tone="danger" hidden></div>
    }

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/offline.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
